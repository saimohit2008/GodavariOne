# Godavari One Mobile Application Environment Configuration
# API base URL pointing to the Godavari One unified backend (/api/v1)

# Local Development:
# - Web browser / iOS Simulator: http://localhost:3000/api/v1
# - Android Emulator:           http://10.0.2.2:3000/api/v1
# - Physical device on Wi-Fi:   http://<YOUR_COMPUTER_LAN_IP>:3000/api/v1

# Production Deployment:
# EXPO_PUBLIC_API_URL=https://godavari.one/api/v1

EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

