{
  "expo": {
    "name": "Godavari One",
    "slug": "godavari-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "godavari-one",
    "userInterfaceStyle": "automatic",
    "description": "Godavari Pushkaralu 2027 Official Digital Companion — Pushkara Ghats, Live Crowd Monitoring, Priority Passes, Accommodations, and Emergency Hotlines.",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.godavarione.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Godavari One uses your location to calculate distances to pushkar ghats, medical centres, and find nearby amenities.",
        "NSCameraUsageDescription": "Godavari One uses your device camera to scan and verify Pushkaralu pilgrim priority pass QR codes at entry gates."
      }
    },
    "android": {
      "package": "org.godavarione.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Godavari One to access your camera to scan and verify Pushkaralu priority entry passes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "08805a02-c227-4570-833e-5780f9c05856"
      }
    }
  }
}
