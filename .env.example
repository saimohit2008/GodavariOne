# Godavari One â€” Godavari Pushkaralu 2027 Digital Platform
# Environment Configuration Template
# Copy this file to .env and fill in values before running the app.
# Local database files are excluded from the public Git repository. Configure your own development database.

# =============================================================================
# ACTIVE DATABASE CONFIGURATION
# =============================================================================
# Local development (default):
DATABASE_URL="file:../db/custom.db"

# Production Supabase PostgreSQL (Transaction pooler mode on Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# Direct PostgreSQL connection string (Used by Prisma CLI for migrations / schema push):
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# =============================================================================
# SUPABASE CLOUD & OBJECT STORAGE CONFIGURATION
# =============================================================================
# Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""

# Server-only Secret Key (Used for server-side/storage operations; NEVER expose to client)
# Modern Supabase projects use SUPABASE_SECRET_KEY (starts with "sb_sec_...").
# Legacy SUPABASE_SERVICE_ROLE_KEY is also supported as a fallback.
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public Client API Key (Anon / Publishable Key for browser clients)
# Modern Supabase uses SUPABASE_PUBLISHABLE_KEY (starts with "sb_pub_...").
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_PUBLISHABLE_KEY=""

# Public Supabase Storage bucket name
SUPABASE_STORAGE_BUCKET="godavari-uploads"

# Storage provider: "local" (default filesystem) or "supabase" (production cloud)
OBJECT_STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"

# Migration target connections (Preflight / migration target without redirecting local dev app):
# SUPABASE_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# SUPABASE_DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# =============================================================================
# APPLICATION RUNTIME & SECURITY
# =============================================================================
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Legacy bootstrap settings. The current application flow does not invoke the bootstrap module.
# Keep disabled unless a reviewed bootstrap workflow is reintroduced.
# BOOTSTRAP_ADMIN_PHONE=""
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_NAME="Godavari One Administrator"

# Authentication & Session Security
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_FOR_SESSIONS"
OTP_TTL_SECONDS="300"
OTP_RESEND_COOLDOWN_MS="60000"
OTP_DEV_MODE="false"

# =============================================================================
# RESEND EMAIL VERIFICATION (Official Provider)
# =============================================================================
# Obtain API key from: https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sender email address on Resend
# On free/trial Resend accounts without a verified domain, use "onboarding@resend.dev"
RESEND_FROM_EMAIL="onboarding@resend.dev"
EMAIL_FROM="Godavari One <onboarding@resend.dev>"

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
GOOGLE_MAPS_API_KEY=""

# Optional SMS gateway configuration.
# Normal registration and login use Resend Email OTP.
# SMS settings are optional and may be used by admin phone-verification workflows.
# Supported SMS_PROVIDER values: twilio, fast2sms, webhook.
SMS_PROVIDER=""

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""

# Fast2SMS or custom webhook
SMS_API_KEY=""
SMS_SENDER_ID="GODAVARI"
SMS_ENDPOINT=""

