// ---------------------------------------------------------------------------
// TRIP COORDINATION & CEREMONY MANAGEMENT (PUROHITS & BOOKINGS)
// ---------------------------------------------------------------------------

model NriTripItineraryItem {
  id                      String    @id @default(cuid())
  requestId               String
  dayNumber               Int
  date                    String    // YYYY-MM-DD
  timeSlot                String?   // e.g. "06:30 - 08:30"
  activityTitle           String
  location                String?
  accommodationDetails    String?
  transportDetails        String?
  assignedProvider        String?
  bookingConfirmationCode String?
  instructions            String?
  internalNotes           String?
  visitorNotes            String?
  status                  String    @default("SCHEDULED") // "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "RESCHEDULED" | "CANCELLED"
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  request                 NriPackageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, dayNumber])
}

model NriTripTask {
  id              String    @id @default(cuid())
  requestId       String
  title           String
  description     String?
  category        String    @default("GENERAL") // "ACCOMMODATION" | "TRANSPORT" | "VIP_PASS" | "PUROHIT" | "GUIDE" | "MEALS" | "GENERAL"
  assignedTo      String?
  dueDate         String?
  status          String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "CONFIRMED" | "COMPLETED" | "CANCELLED"
  confirmationRef String?
  internalNotes   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  request         NriPackageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
}

model PurohitProfile {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  fullName            String
  profilePhotoUrl     String?
  phone               String
  email               String?
  address             String
  serviceArea         String
  languages           String    // JSON array: ["Telugu", "Sanskrit", "Hindi", "English"]
  ceremonies          String    // JSON array of ceremony types
  experienceYears     Int       @default(5)
  qualifications      String?
  customaryPractices  String?
  baseFee             Float     @default(0)
  feeIncludes         String?
  preferredContact    String    @default("PHONE") // "PHONE" | "WHATSAPP" | "EMAIL"
  workingDays         String    @default("[\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\",\"FRIDAY\",\"SATURDAY\",\"SUNDAY\"]")
  workingHoursStart   String    @default("06:00") // HH:MM
  workingHoursEnd     String    @default("18:00") // HH:MM
  breakStart          String?   @default("12:30") // HH:MM
  breakEnd            String?   @default("14:00") // HH:MM
  slotDurationMinutes Int       @default(60)
  advanceBookingDays  Int       @default(60)
  cancellationHours   Int       @default(24)
  verificationStatus  String    @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  isActive            Boolean   @default(true)
  isPublished         Boolean   @default(true)
  supportingDocuments String?   // JSON array of document objects { name, url, uploadDate }
  bio                 String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings            CeremonyBooking[]
  blockedPeriods      PurohitBlockedSlot[]

  @@index([verificationStatus, isActive, isPublished])
  @@index([serviceArea])
}

model PurohitBlockedSlot {
  id          String    @id @default(cuid())
  purohitId   String
  startDate   String    // YYYY-MM-DD
  endDate     String    // YYYY-MM-DD
  startTime   String?   // HH:MM
  endTime     String?   // HH:MM
  reason      String?
  isAllDay    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  purohit     PurohitProfile @relation(fields: [purohitId], references: [id], onDelete: Cascade)

  @@index([purohitId, startDate, endDate])
}

model CeremonyBooking {
  id                     String    @id @default(cuid())
  bookingReference       String    @unique // e.g. "CER-2027-ABC123"
  purohitId              String
  visitorId              String?
  visitorName            String
  visitorPhone           String
  visitorEmail           String?
  ceremonyType           String
  bookingDate            String    // YYYY-MM-DD
  startTime              String    // HH:MM
  endTime                String    // HH:MM
  durationMinutes        Int       @default(60)
  participantsCount      Int       @default(1)
  locationType           String    @default("GHAT") // "GHAT" | "HOME_HOTEL" | "TEMPLE"
  locationAddress        String
  customaryRequirements String?
  serviceFee             Float     @default(0)
  currency               String    @default("INR")
  feeIncludes            String?
  status                 String    @default("PENDING") // "PENDING" | "CONFIRMED" | "DECLINED" | "RESCHEDULE_REQUESTED" | "CANCELLED" | "COMPLETED"
  declineReason          String?
  cancellationReason     String?
  rescheduleReason       String?
  rescheduleProposedDate String?
  rescheduleProposedTime String?
  confirmedAt            DateTime?
  completedAt            DateTime?
  internalNotes          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  purohit                PurohitProfile @relation(fields: [purohitId], references: [id], onDelete: Cascade)
  visitor                User?          @relation("VisitorCeremonyBookings", fields: [visitorId], references: [id], onDelete: SetNull)
  statusHistory          CeremonyBookingStatusHistory[]

  @@index([purohitId, bookingDate, status])
  @@index([bookingReference])
  @@index([visitorId])
  @@index([status])
}

model CeremonyBookingStatusHistory {
  id            String          @id @default(cuid())
  bookingId     String
  fromStatus    String
  toStatus      String
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime        @default(now())

  booking       CeremonyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ---------------------------------------------------------------------------
// PRIORITY GHAT BOOKINGS (Senior Citizens 65+ & Persons with Disabilities)
// ---------------------------------------------------------------------------

model GhatTimeSlot {
  id                 String   @id @default(cuid())
  ghatId             String
  slotDate           String   // YYYY-MM-DD
  startTime          String   // HH:MM (24-hour, e.g. "06:00")
  endTime            String   // HH:MM (24-hour, e.g. "07:30")
  maxCapacity        Int      @default(50)
  allocatedCount     Int      @default(0)
  status             String   @default("ACTIVE") // "ACTIVE" | "PAUSED" | "CLOSED"
  accessibilityNotes String?
  maxAccompanying    Int      @default(1)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ghat               Listing  @relation(fields: [ghatId], references: [id], onDelete: Cascade)
  createdBy          User?    @relation("TimeSlotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookings           PriorityGhatBooking[]

  @@index([ghatId, slotDate, status])
  @@index([slotDate])
  @@index([createdById])
}

model PriorityGhatBooking {
  id                       String    @id @default(cuid())
  applicationNumber        String    @unique // e.g. "PGB-2027-ABC123"
  qrPassToken              String?   @unique // Cryptographic opaque token for verified entry
  ghatId                   String
  timeSlotId               String?
  userId                   String?   // User account who submitted the application
  category                 String    // "SENIOR_CITIZEN" | "PERSON_WITH_DISABILITY"
  beneficiaryName          String
  beneficiaryDob           String?   // YYYY-MM-DD (mandatory for SENIOR_CITIZEN)
  beneficiaryAge           Int?
  beneficiaryPhone         String
  beneficiaryEmail         String?
  isCaregiverApplication   Boolean   @default(false)
  applicantName            String?
  applicantPhone           String?
  applicantRelationship    String?
  visitDate                String    // Proposed/assigned visit date YYYY-MM-DD
  accompanyingCount        Int       @default(0)
  accessibilityNeeds       String?   // Wheelchair, ramp assistance, guide, etc.
  documentPath             String    // Stored in private directory, never public
  documentOriginalName     String
  documentMimeType         String
  documentSizeBytes        Int
  documentUploadedAt       DateTime  @default(now())
  // Workflow: "SUBMITTED" | "UNDER_REVIEW" | "ADDITIONAL_PROOF_REQUIRED" | "APPROVED" | "SLOT_ASSIGNED" | "REJECTED" | "CANCELLED" | "CHECKED_IN"
  status                   String    @default("SUBMITTED")
  reviewerId               String?
  reviewerNotes            String?
  rejectionReason          String?
  additionalProofNotes     String?
  superAdminOverrideReason String?
  slotAssignedAt           DateTime?
  checkedInAt              DateTime?
  checkedInById            String?
  checkedInMethod          String?   // "QR_SCAN" | "MANUAL_VERIFICATION"
  applicantDeclaration     Boolean   @default(true)
  consentGiven             Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  ghat                     Listing   @relation(fields: [ghatId], references: [id], onDelete: Cascade)
  timeSlot                 GhatTimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  user                     User?     @relation("ApplicantPriorityBookings", fields: [userId], references: [id], onDelete: SetNull)
  reviewer                 User?     @relation("ReviewerPriorityBookings", fields: [reviewerId], references: [id], onDelete: SetNull)
  checkedInBy              User?     @relation("CheckInPriorityBookings", fields: [checkedInById], references: [id], onDelete: SetNull)
  history                  PriorityBookingHistory[]

  @@index([ghatId, status])
  @@index([category, status])
  @@index([userId])
  @@index([visitDate])
  @@index([timeSlotId])
  @@index([reviewerId])
  @@index([checkedInById])
}

model PriorityBookingHistory {
  id            String   @id @default(cuid())
  bookingId     String
  fromStatus    String
  toStatus      String
  changedById   String?
  changedByName String?
  reason        String?
  metadata      String?  // JSON
  createdAt     DateTime @default(now())

  booking       PriorityGhatBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ---------------------------------------------------------------------------
// AUTOMATED EMAIL NOTIFICATIONS OUTBOX & AUDIT
// ---------------------------------------------------------------------------

model EmailNotification {
  id                String    @id @default(cuid())
  eventType         String    // "BOOKING_SUCCESSFUL" | "BOOKING_CANCELLED" | "BOOKING_APPROVED" | "BOOKING_REJECTED" | "BOOKING_RESCHEDULED" | "BOOKING_REMINDER_24H" | "BOOKING_REMINDER_2H" | "GHAT_CLOSURE" | "GHAT_REOPENED"
  userId            String?
  bookingId         String?
  bookingReference  String?
  bookingCategory   String?   // "HOTEL" | "RESTAURANT" | "CEREMONY" | "GHAT_PRIORITY" | "FREE_ACCOMMODATION" | "NRI_PACKAGE"
  recipientEmail    String
  recipientName     String?
  language          String    @default("en") // "en" | "te"
  subject           String
  payload           String    // JSON string containing safe template render fields
  status            String    @default("PENDING") // "PENDING" | "PROCESSING" | "SENT" | "FAILED" | "CANCELLED"
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(3)
  providerMessageId String?
  scheduledFor      DateTime  @default(now())
  sentAt            DateTime?
  lastError         String?
  idempotencyKey    String    @unique
  metadata          String?   // JSON string
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([bookingId])
  @@index([eventType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI ASSISTANT PLATFORM: RATE LIMITING, CONFIGURATION & BUDGET ENFORCEMENT
// ---------------------------------------------------------------------------

model AIRateLimit {
  id           String   @id // Cryptographically hashed identifier: sha256(prefix + id + windowEpoch)
  requestCount Int      @default(1)
  windowStart  DateTime @default(now())
  expiresAt    DateTime // Used for automated pruning
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@index([windowStart])
}

model AISystemConfig {
  id               String   @id @default("default")
  isEnabled        Boolean  @default(true)
  provider         String   @default("gemini")
  model            String   @default("gemini-1.5-flash")
  monthlyBudgetCap Float    @default(25.0)
  temperature      Float    @default(0.3)
  maxTokens        Int      @default(800)
  rateLimitPerMin  Int      @default(30)
  updatedBy        String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model AIUsageLog {
  id               String   @id @default(cuid())
  conversationId   String?
  userId           String?
  userRole         String   @default("VISITOR")
  provider         String   // "gemini" | "openai" | "groq" | "mock"
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0.0)
  status           String   @default("COMPLETED") // "RESERVED" | "COMPLETED" | "FAILED" | "RELEASED"
  isReservation    Boolean  @default(false)
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

