// Godavari One — Godavari Pushkaralu 2027 Digital Platform
// Prisma schema (SQLite for local development, portable to PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-pg"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// USERS, ROLES, SESSIONS, AUTH
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?
  name         String?
  // scrypt hash, never plaintext
  passwordHash String?
  // Exactly 7 approved application roles: "SUPER_ADMIN" | "VISITOR" | "BUSINESS_OWNER" | "BOOKING_REVIEWER" | "GHAT_SUPERVISOR" | "PUROHIT" | "NRI_SERVICE_MANAGER"
  role         String   @default("VISITOR")
  // "ACTIVE" | "SUSPENDED" | "DEACTIVATED"
  status       String   @default("ACTIVE")
  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)
  // MFA secret (TOTP) for SUPER_ADMIN, base32, encrypted-at-rest in production
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  listingsOwned  Listing[]        @relation("OwnerListings")
  assignments   Assignment[]
  bookings       RestaurantBooking[] @relation("UserRestaurantBookings")
  hotelBookings  HotelBooking[]      @relation("UserHotelBookings")
  ghatReports    GhatReport[]
  notifications  Notification[]
  favorites      Favorite[]
  auditLogs      AuditLog[]         @relation("ActorAuditLogs")
  reviews        Review[]           @relation("UserReviews")
  reviewReports  ReviewReport[]     @relation("UserReviewReports")
  moderatedReviews Review[]         @relation("ModeratedReviews")
  resolvedReports ReviewReport[]    @relation("ResolvedReports")
  createdUsers   User[]              @relation("UserCreatedBy")
  createdBy      User?               @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById    String?
  otpChallenges  OtpChallenge[]
  createdBanners CarouselBanner[]    @relation("BannerCreatedBy")
  editedBanners  CarouselBanner[]    @relation("BannerLastEditedBy")
  createdHomepageItems HomepageContentItem[] @relation("ItemCreatedBy")
  editedHomepageItems  HomepageContentItem[] @relation("ItemLastEditedBy")
  freeAccommodationBookings FreeAccommodationBooking[]
  nriRequests             NriPackageRequest[]        @relation("VisitorNriRequests")
  nriAssignments          NriRequestAssignment[]     @relation("ProviderNriAssignments")
  nriQuotations           NriQuotation[]             @relation("ProviderNriQuotations")
  nriMessages             NriMessage[]               @relation("UserNriMessages")
  managedNriRequests      NriPackageRequest[]        @relation("ManagerNriRequests")
  purohitProfile          PurohitProfile?
  ceremonyBookings        CeremonyBooking[]          @relation("VisitorCeremonyBookings")
  priorityBookingsSubmitted PriorityGhatBooking[]    @relation("ApplicantPriorityBookings")
  priorityBookingsReviewed  PriorityGhatBooking[]    @relation("ReviewerPriorityBookings")
  priorityBookingsCheckedIn PriorityGhatBooking[]    @relation("CheckInPriorityBookings")
  timeSlotsCreated          GhatTimeSlot[]           @relation("TimeSlotCreatedBy")
  emailNotifications        EmailNotification[]

  @@index([createdById])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  // "PASSWORD" | "OTP" | "ADMIN"
  authMethod String  @default("PASSWORD")
  mfaCleared Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  // sha-256 hex hash of the OTP code
  codeHash  String
  // "LOGIN" | "REGISTER" | "RESET"
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([phone])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  userId    String?

  @@index([email])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String
  name         String
  passwordHash String
  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// ---------------------------------------------------------------------------
// ASSIGNMENTS (owner/editor/ghat/category/booking-queue scoping)
// ---------------------------------------------------------------------------

model Assignment {
  id        String   @id @default(cuid())
  userId    String
  // "LISTING_OWNER" | "GHAT_REPORTER" | "GHAT_SUPERVISOR" |
  // "CATEGORY_EDITOR" | "BOOKING_REVIEWER"
  type      String
  // polymorphic scoping
  listingId String?
  category  String?
  district  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
}

// ---------------------------------------------------------------------------
// LISTINGS + CATEGORY-SPECIFIC DETAILS + IMAGES
// ---------------------------------------------------------------------------

model Listing {
  id           String   @id @default(cuid())
  name         String
  // Exactly 9 approved directory categories: "RESTAURANT" | "HOTEL" | "GHAT" | "HOSPITAL" | "TRANSPORT" | "TOURIST_SPOT" | "FREE_ACCOMMODATION" | "ANNADANAM" | "CEREMONY"
  category     String
  description  String
  address      String
  district     String?
  town         String?
  locality     String?
  phone        String?
  email        String?
  latitude     Float?
  longitude    Float?
  mapsUrl      String?
  // location verified means coords validated
  locationVerified Boolean @default(false)
  accessibility String? // JSON string of accessibility flags
  facilities    String? // JSON string of facilities
  // publication lifecycle: "DRAFT" | "PENDING" | "APPROVED" | "PUBLISHED" |
  // "REJECTED" | "SUSPENDED" | "ARCHIVED"
  publicationStatus String @default("DRAFT")
  // "UNVERIFIED" | "VERIFIED"
  verificationStatus String @default("UNVERIFIED")
  rejectionReason String?
  verifiedById String?
  verifiedAt   DateTime?
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner       User?           @relation("OwnerListings", fields: [ownerId], references: [id])
  images      ListingImage[]
  assignments Assignment[]
  schedule    ListingSchedule?
  restaurantDetails RestaurantDetails?
  hotelDetails      HotelDetails?
  hotelRooms        HotelRoom[]
  ghatDetails       GhatDetails?
  hospitalDetails   HospitalDetails?
  transportDetails  TransportDetails?
  touristDetails    TouristDetails?
  freeAccommodationDetails FreeAccommodationDetails?
  annadanamDetails         AnnadanamDetails?
  restaurantBookings RestaurantBooking[]
  hotelBookings     HotelBooking[]
  freeAccommodationBookings FreeAccommodationBooking[]
  ghatReports       GhatReport[]
  favorites         Favorite[]
  reviews           Review[]
  homepageItems     HomepageContentItem[]
  carouselBanners   CarouselBanner[]
  priorityBookings  PriorityGhatBooking[]
  ghatTimeSlots     GhatTimeSlot[]

  @@index([category])
  @@index([publicationStatus])
  @@index([ownerId])
  @@index([publicationStatus, createdAt(sort: Desc)])
  @@index([publicationStatus, category, createdAt(sort: Desc)])
  @@index([district, town])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  // relative path under uploads dir, e.g. /uploads/2027/abc.jpg
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  isPrimary Boolean  @default(false)
  orderIdx  Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model RestaurantDetails {
  listingId           String  @id
  cuisine             String?
  // "VEG" | "NON_VEG" | "EGGETARIAN" | "BOTH"
  foodType            String?
  priceRange          String?
  openingHours        String?
  tableCapacity       Int?
  reservationAvailable Boolean @default(true)
  seatingAccessibility String?
  listing             Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model HotelDetails {
  listingId        String  @id
  accommodationType String?
  roomTypes        String? // JSON
  numRooms         Int?
  roomCapacity     Int?
  checkInTime      String?
  checkOutTime     String?
  amenities        String? // JSON
  priceRange       String?
  bookingContact   String?
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model GhatDetails {
  listingId         String  @id
  accessRoutes      String? // JSON
  facilities        String? // JSON
  accessibility     String? // JSON
  medicalAssistance String?
  // current crowd status mirror for quick reads
  currentCrowdStatus String? // "FREE" | "MODERATE" | "CROWDED" | "OVERCROWDED" | "EMERGENCY"
  statusUpdatedAt   DateTime?
  supervisorId      String?
  listing           Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model HospitalDetails {
  listingId         String  @id
  facilityType      String?
  emergencyAvailable Boolean @default(false)
  services          String? // JSON
  operatingHours    String?
  listing           Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model TransportDetails {
  listingId    String  @id
  transportType String? // "TAXI" | "AUTO" | "BUS" | "RENTAL"
  serviceAreas String? // JSON
  vehicleDetails String?
  pricing      String?
  driverOption  Boolean @default(false)
  listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model TouristDetails {
  listingId      String  @id
  openingHours   String?
  entryFee       String?
  facilities     String? // JSON
  accessibility  String? // JSON
  directions     String?
  listing        Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model FreeAccommodationDetails {
  listingId           String    @id
  accommodationType   String?   // "DORMITORY" | "HALL" | "ROOMS" | "MIXED"
  availableTypes      String?   // JSON array e.g. ["Dormitory Hall", "Separate Family Rooms", "Senior Citizen Floor"]
  totalCapacity       Int?
  availableCapacity   Int?
  capacityMen         Int?
  availableMen        Int?
  capacityWomen       Int?
  availableWomen      Int?
  capacityFamily      Int?
  availableFamily     Int?
  checkInTime         String?   // e.g. "08:00"
  checkOutTime        String?   // e.g. "20:00"
  maxStayDays         Int?      @default(3)
  rules               String?
  eligibilityCriteria String?   // Required docs e.g. "Aadhaar Card, Pilgrim Pass"
  amenities           String?   // JSON array e.g. ["Drinking Water", "Mattresses/Bedding", "Western Toilets", "Bathing Facilities", "Lockers"]
  requiresRegistration Boolean  @default(false)
  registrationUrl     String?
  registrationContact String?
  isTemporarilyUnavailable Boolean @default(false)
  availabilityStatus  String?   // "AVAILABLE" | "FEW_LEFT" | "FULL" | "NOT_CONFIRMED" | "UNAVAILABLE"
  lastAvailabilityUpdate DateTime?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  listing             Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AnnadanamDetails {
  listingId           String    @id
  organizationName    String?
  distributionType    String?   // "MEALS" | "ANNADANAM" | "PRASADAM" | "ALL"
  dietaryInfo         String?   // "PURE_VEG" | "SATVIK" | "PRASADAM_ONLY"
  servingStatus       String    @default("ACTIVE") // "ACTIVE" | "PAUSED" | "ENDED" | "TEMPORARILY_UNAVAILABLE"
  sessions            String?   // JSON array of sessions e.g. [{"name":"Morning Breakfast","start":"07:00","end":"09:30","type":"BREAKFAST"}]
  seatingCapacity     Int?
  queueWaitMinutes    Int?      // Estimated wait time in minutes
  remainingServings   Int?      // Optional live servings count
  eligibilityRules    String?
  specialDates        String?   // Date or festival notes
  lastStatusUpdate    DateTime?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  listing             Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// BOOKINGS
// ---------------------------------------------------------------------------

model RestaurantBooking {
  id             String   @id @default(cuid())
  listingId      String
  userId         String
  bookingDate    String   // YYYY-MM-DD
  timeSlot       String   // e.g. "12:30"
  peopleCount    Int
  specialRequest String?
  // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED" | "COMPLETED" | "NO_SHOW"
  status         String   @default("PENDING")
  rejectionReason String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user           User     @relation("UserRestaurantBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, bookingDate, timeSlot])
  @@index([userId])
}

model ListingSchedule {
  id                     String    @id @default(cuid())
  listingId              String    @unique
  open24Hours            Boolean   @default(false)
  isTemporarilyClosed    Boolean   @default(false)
  temporaryClosureReason String?
  temporaryClosureUntil  DateTime?
  openingTime            String?   // "HH:MM" e.g. "06:00" in IST
  closingTime            String?   // "HH:MM" e.g. "21:00" in IST
  operatingDays          String?   // JSON array e.g. ["MONDAY","TUESDAY",...]
  closedDays             String?   // JSON array e.g. ["SUNDAY"]
  breakStart             String?   // "HH:MM" e.g. "13:00"
  breakEnd               String?   // "HH:MM" e.g. "16:00"
  intervals              String?   // JSON array e.g. [{"open":"06:00","close":"12:00"},{"open":"17:00","close":"21:00"}]
  specialHours           String?   // JSON array of { date: string, isClosed: boolean, open?: string, close?: string, note?: string }
  timezone               String    @default("Asia/Kolkata")
  lastUpdatedById        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  listing                Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model HotelRoom {
  id               String         @id @default(cuid())
  listingId        String
  name             String         // e.g. Standard, Deluxe, Family Suite, Dormitory
  roomIdentifier   String?        // e.g. "101-110", "Block A"
  description      String?
  totalRooms       Int            @default(1)
  maxAdults        Int            @default(2)
  maxChildren      Int            @default(1)
  maxGuests        Int            @default(3)
  basePrice        Float          @default(0)
  extraPersonPrice Float          @default(0)
  amenities        String?        // JSON array of strings
  bedType          String?        // e.g. "1 King Bed", "2 Twin Beds"
  bedCount         Int            @default(1)
  images           String?        // JSON array of URLs
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings         HotelBooking[]

  @@index([listingId])
  @@index([isActive])
}

model HotelBooking {
  id             String      @id @default(cuid())
  listingId      String
  roomId         String?
  userId         String
  checkIn        String      // YYYY-MM-DD
  checkOut       String      // YYYY-MM-DD
  guests         Int
  rooms          Int
  adults         Int?
  children       Int?
  basePrice      Float?
  extraCharges   Float?
  totalPrice     Float?
  specialRequest String?
  status         String      @default("PENDING")
  rejectionReason String?
  reviewedById   String?
  reviewedAt     DateTime?
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  listing        Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room           HotelRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user           User        @relation("UserHotelBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, checkIn, checkOut])
  @@index([roomId, checkIn, checkOut])
  @@index([userId])
}

model FreeAccommodationBooking {
  id             String    @id @default(cuid())
  listingId      String
  userId         String
  checkInDate    String    // YYYY-MM-DD
  checkOutDate   String    // YYYY-MM-DD
  peopleCount    Int
  groupType      String    @default("FAMILY") // "MEN" | "WOMEN" | "FAMILY" | "MIXED"
  guestName      String
  guestPhone     String
  idProofType    String?   // "AADHAAR" | "VOTER_ID" | "PASSPORT"
  idProofNumber  String?
  specialNotes   String?
  status         String    @default("CONFIRMED") // "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED" | "NO_SHOW"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, checkInDate])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// GHAT CROWD MONITORING
// ---------------------------------------------------------------------------

model GhatReport {
  id            String   @id @default(cuid())
  listingId     String
  reporterId    String
  // "FREE" | "MODERATE" | "CROWDED" | "OVERCROWDED" | "EMERGENCY"
  crowdStatus   String
  notes         String?
  // "BLOCKED_ACCESS" | "MEDICAL_ASSISTANCE" | "FACILITY_ISSUE" | "NONE"
  incidentType  String   @default("NONE")
  // "SUBMITTED" | "ACKNOWLEDGED" | "ESCALATED" | "RESOLVED"
  reviewStatus  String   @default("SUBMITTED")
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt     DateTime @default(now())
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter      User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([reporterId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS, FAVORITES, AUDIT
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetType String?
  targetId  String?
  details   String? // JSON
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// REVIEWS & FEEDBACK SYSTEM
// ---------------------------------------------------------------------------

model Review {
  id               String         @id @default(cuid())
  listingId        String
  userId           String
  rating           Int            // 1 to 5
  title            String?
  content          String         // feedback description
  issueCategory    String?        // "CLEANLINESS" | "OVERCROWDING" | "SAFETY" | "STAFF_BEHAVIOUR" | "FACILITIES" | "PRICING" | "SERVICE_QUALITY" | "GENERAL"
  photos           String?        // JSON array of strings
  status           String         @default("PUBLISHED") // "PUBLISHED" | "HIDDEN" | "REMOVED"
  isFlagged        Boolean        @default(false)
  flagReason       String?
  moderatedById    String?
  moderationReason String?        // "ABUSIVE_LANGUAGE" | "SPAM" | "PERSONAL_INFO" | "HARASSMENT" | "IRRELEVANT" | "OTHER"
  moderatedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user             User           @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  moderator        User?          @relation("ModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)
  reports          ReviewReport[]

  @@index([listingId, status])
  @@index([userId])
  @@index([status])
  @@index([moderatedById])
}

model ReviewReport {
  id              String    @id @default(cuid())
  reviewId        String
  reporterId      String
  reason          String    // "ABUSIVE_LANGUAGE" | "SPAM" | "PERSONAL_INFO" | "HARASSMENT" | "IRRELEVANT" | "OTHER"
  details         String?
  status          String    @default("PENDING") // "PENDING" | "RESOLVED" | "DISMISSED"
  resolvedById    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  review          Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter        User      @relation("UserReviewReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver        User?     @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([reporterId])
  @@index([status])
  @@index([resolvedById])
}

// ---------------------------------------------------------------------------
// HOMEPAGE CAROUSEL BANNERS
// ---------------------------------------------------------------------------

model CarouselBanner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  description     String?
  imageUrl        String
  destinationUrl  String?
  orderIdx        Int       @default(0)
  isEnabled       Boolean   @default(true)
  status          String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  startDate       DateTime?
  endDate         DateTime?
  contentType     String    @default("GENERAL_PROMOTION") // "ADVERTISEMENT" | "EVENT" | "ANNOUNCEMENT" | "TOURIST_ATTRACTION" | "HOTEL" | "RESTAURANT" | "NRI_INFORMATION" | "GENERAL_PROMOTION"
  advertiserName  String?
  contactPhone    String?
  contactEmail    String?
  location        String?
  websiteUrl      String?
  ctaLabel        String?   @default("Learn More")
  destinationType String    @default("EXTERNAL_URL") // "DIRECTORY_LISTING" | "NRI_SECTION" | "INTERNAL_PAGE" | "EXTERNAL_URL"
  listingId       String?
  slug            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  lastEditedById  String?

  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdBy       User?     @relation("BannerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy    User?     @relation("BannerLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@index([isEnabled, status, orderIdx])
  @@index([contentType])
  @@index([listingId])
  @@index([createdById])
  @@index([lastEditedById])
}

// ---------------------------------------------------------------------------
// HOMEPAGE SECTION CONFIGURATION & CONTENT MANAGEMENT
// ---------------------------------------------------------------------------

model HomepageSection {
  id          String   @id // e.g. "hero", "carousel", "announcements", "categories", "featured_listings", "free_services", "ghats", "accessibility"
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  orderIdx    Int      @default(0)
  settings    String?  // JSON formatted configuration
  updatedAt   DateTime @updatedAt
  lastEditedById String?
}

model HomepageContentItem {
  id             String    @id @default(cuid())
  section        String    // "HERO" | "CAROUSEL" | "ANNOUNCEMENT" | "PROMO_BANNER" | "FEATURED_LISTING" | "FREE_SERVICES" | "CUSTOM"
  title          String
  description    String?
  buttonText     String?
  imageUrl       String?
  destinationUrl String?
  listingId      String?
  badgeText      String?
  orderIdx       Int       @default(0)
  isEnabled      Boolean   @default(true)
  status         String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  startDate      DateTime?
  endDate        DateTime?
  metadata       String?   // JSON string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  lastEditedById String?

  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdBy      User?     @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?     @relation("ItemLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@index([section, isEnabled, status, orderIdx])
  @@index([listingId])
  @@index([createdById])
  @@index([lastEditedById])
}

// ---------------------------------------------------------------------------
// NRI CUSTOM PACKAGE REQUESTS, QUOTATIONS & BOOKING WORKFLOW
// ---------------------------------------------------------------------------

model NriPackageRequest {
  id                      String    @id @default(cuid())
  referenceNumber         String    @unique // e.g. "NRI-2027-ABC123"
  visitorId               String?   // Linked to User if authenticated
  visitorName             String
  visitorEmail            String
  visitorPhone            String
  countryOfResidence      String
  groupSize               Int       // 2 to 10
  numAdults               Int
  numChildren             Int
  arrivalDate             String    // YYYY-MM-DD
  departureDate           String    // YYYY-MM-DD
  arrivalLocation         String
  departureLocation       String
  accommodationPreference String
  numRooms                Int?      @default(1)
  dietaryPreference       String
  specialRequests         String?
  preferredItinerary      String?
  budgetRange             String?
  currency                String    @default("INR")
  targetProviderId        String?   // Specific provider requested by visitor, if any
  status                  String    @default("SUBMITTED") // SUBMITTED, ASSIGNED, IN_PROGRESS, QUOTATION_SENT, REVISION_REQUESTED, QUOTATION_ACCEPTED, AWAITING_FINAL_CONFIRMATION, CONFIRMED, DECLINED, EXPIRED, CANCELLED, CLOSED
  confirmedQuotationId    String?
  confirmationNotes       String?
  confirmedAt             DateTime?
  responseDeadline        DateTime?
  preferredCommunication  String?   @default("WHATSAPP")
  accessibilityRequirements String?
  daysCount               Int?
  nightsCount             Int?
  placesToVisit           String?
  preferredGhats          String?
  preferredTemples        String?
  preferredRoomType       String?
  transportRequirements   String?
  localGuideRequired      Boolean?  @default(false)
  guideLanguage           String?
  ceremonyRequirements    String?
  packageTypePreference   String?
  additionalInstructions  String?
  assignedManagerId       String?
  rejectionReason         String?
  cancellationReason      String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visitor                 User?                  @relation("VisitorNriRequests", fields: [visitorId], references: [id], onDelete: SetNull)
  assignedManager         User?                  @relation("ManagerNriRequests", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  assignments             NriRequestAssignment[]
  quotations              NriQuotation[]
  messages                NriMessage[]
  statusHistory           NriStatusHistory[]
  tripItineraryItems      NriTripItineraryItem[]
  tripTasks               NriTripTask[]

  @@index([referenceNumber])
  @@index([visitorId])
  @@index([assignedManagerId])
  @@index([status])
  @@index([createdAt])
}

model NriRequestAssignment {
  id            String    @id @default(cuid())
  requestId     String
  providerId    String
  status        String    @default("ASSIGNED") // "ASSIGNED" | "VIEWED" | "IN_PROGRESS" | "QUOTED" | "DECLINED"
  declineReason String?
  assignedAt    DateTime  @default(now())
  viewedAt      DateTime?
  respondedAt   DateTime?

  request       NriPackageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider      User              @relation("ProviderNriAssignments", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([providerId, status])
  @@index([requestId])
}

model NriQuotation {
  id                  String    @id @default(cuid())
  quotationNumber     String    @unique // e.g. "QTE-2027-ABC123"
  requestId           String
  providerId          String
  version             Int       @default(1)
  status              String    @default("DRAFT") // "DRAFT" | "SENT" | "REVISION_REQUESTED" | "ACCEPTED" | "DECLINED" | "WITHDRAWN" | "CONFIRMED" | "CLOSED"
  title               String
  description         String?
  durationDays        Int
  checkInDate         String
  checkOutDate        String
  itinerary           String    // JSON array of day schedules
  pickupDropDetails   String?
  vehicleType         String?
  vehicleCapacity     Int?
  hotelName           String?
  roomType            String?
  numberOfRooms       Int?      @default(1)
  accommodationDetails String?
  mealPlan            String?
  guideServices       String?
  inclusions          String    // JSON array
  exclusions          String    // JSON array
  termsAndConditions  String?
  cancellationPolicy  String?
  accommodationCost   Float     @default(0)
  transportCost       Float     @default(0)
  foodCost            Float     @default(0)
  guideCost           Float     @default(0)
  otherCharges        Float     @default(0)
  taxAmount           Float     @default(0)
  discountAmount      Float     @default(0)
  totalPrice          Float
  pricePerPerson      Float
  currency            String    @default("INR")
  ceremonyCost        Float     @default(0)
  additionalFeesExplanation String?
  validUntil          DateTime?
  managerNotes        String?
  internalNotes       String?
  pricingNotes        String?
  revisionNotes       String?
  withdrawalReason    String?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  request             NriPackageRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider            User                   @relation("ProviderNriQuotations", fields: [providerId], references: [id], onDelete: Cascade)
  versions            NriQuotationVersion[]
  lineItems           NriQuotationLineItem[]

  @@index([requestId])
  @@index([providerId])
  @@index([status])
}

model NriQuotationVersion {
  id            String       @id @default(cuid())
  quotationId   String
  version       Int
  snapshot      String       // JSON string of quotation snapshot
  changeSummary String?
  createdById   String
  createdAt     DateTime     @default(now())

  quotation     NriQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, version])
  @@index([quotationId])
}

model NriQuotationLineItem {
  id          String       @id @default(cuid())
  quotationId String
  category    String       // "ACCOMMODATION" | "TRANSPORT" | "MEALS" | "SIGHTSEEING_GUIDE" | "TAX_FEES" | "DISCOUNT" | "OTHER"
  description String
  quantity    Int          @default(1)
  unitPrice   Float
  totalPrice  Float
  isOptional  Boolean      @default(false)

  quotation   NriQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model NriMessage {
  id               String            @id @default(cuid())
  requestId        String
  senderId         String
  senderRole       String            // "VISITOR" | "BUSINESS_OWNER" | "SUPER_ADMIN"
  senderName       String
  message          String
  attachments      String?
  readByRecipient  Boolean           @default(false)
  createdAt        DateTime          @default(now())

  request          NriPackageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender           User              @relation("UserNriMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([senderId])
}

model NriStatusHistory {
  id            String            @id @default(cuid())
  requestId     String
  fromStatus    String
  toStatus      String
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime          @default(now())

  request       NriPackageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// NRI PORTAL CONFIGURATION & MANAGED CONTENT (ANNOUNCEMENTS, SERVICES, CARDS)
